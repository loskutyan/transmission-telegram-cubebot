# Telegram
TELEGRAM_BOT_TOKEN=replace-with-a-token-from-botfather
TELEGRAM_ALLOWED_USER_IDS=123456789
# Optional: group/supergroup chat IDs allowed to submit .torrent files.
TELEGRAM_ALLOWED_GROUP_IDS=-1001234567890

# Transmission inside the same Docker network
TRANSMISSION_RPC_URL=http://transmission:9091/transmission/rpc
# Set both fields if RPC authentication is enabled.
TRANSMISSION_RPC_USERNAME=
TRANSMISSION_RPC_PASSWORD=

# Runtime limits
MAX_TORRENT_FILE_BYTES=5242880
RPC_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
TZ=Europe/Moscow
